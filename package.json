{
  "name": "burro-bluetooth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "npm run build && npx cap sync android && node scripts/patch-ble-peripheral.mjs && npx cap run android",
    "setup:android": "npx cap add android && node scripts/patch-manifest.mjs && npm run build && npx cap sync android && node scripts/patch-ble-peripheral.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/vue": "^9.0.5",
    "@ionic/vue-router": "^9.0.5",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-ble-peripheral": "^1.0.0",
    "ionicons": "^7.4.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0"
  }
}